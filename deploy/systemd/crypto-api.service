[Unit]
Description=Crypto API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/crypto
EnvironmentFile=/root/crypto/.env
ExecStart=/root/crypto/.venv/bin/python -m uvicorn app.api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
