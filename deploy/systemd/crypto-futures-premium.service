[Unit]
Description=Crypto Futures Premium Metrics Collector
After=network-online.target crypto-api.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/crypto
EnvironmentFile=/root/crypto/.env
ExecStartPre=/usr/bin/rm -f /root/crypto/runtime/futures_premium.pid
ExecStart=/root/crypto/.venv/bin/python /root/crypto/scripts/run_futures_premium_collector.py --interval 60
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
